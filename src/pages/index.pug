extends /layouts/main

block append meta
  meta(
    name="description"
    content="Keepsake - студія брендингу, друку та веб-дизайну. Речі, які хочеться зберегти."
  )
  meta(property="og:type" content="website")
  meta(property="og:title" content="Keepsake - студія брендингу та дизайну")
  meta(property="og:description" content="Брендинг, друк і веб-дизайн з увагою до деталей.")
  meta(name="theme-color" content="#ff6b5b")

block title
  | Keepsake - студія брендингу та дизайну

block prepend scripts
  - const studio = { "@context": "https://schema.org", "@type": "Organization", name: "Keepsake", email: "hello@keepsake.example" };
  script(type="application/ld+json")!= JSON.stringify(studio)

block content
  include /components/sections/hero
  include /components/sections/services
  include /components/sections/works
  include /components/sections/stats
  include /components/sections/journal
  include /components/sections/contact
