header.header
  .container.header__inner
    a.logo(href="#top" aria-label="Keepsake - на початок")
      include /includes/logo
    button.header__toggle(type="button" aria-expanded="false" aria-controls="site-nav")
      span.visually-hidden Меню
      span.header__burger(aria-hidden="true")
    nav#site-nav.nav(aria-label="Головна навігація")
      ul.nav__list
        each item, i in navItems
          li.nav__item
            //- active - необов'язкове поле даних: клас і aria-current лише для активного пункту
            if item.active
              a.nav__link.nav__link--active(href=item.href aria-current="location")= item.label
            else
              a.nav__link(href=item.href)= item.label
      +btn("Зв’язатися", "#contact")(aria-label="Зв’язатися зі студією")
