+section("clients", "Our Clients")
  ul.client-logos
    li.client-logos__item.client-logos__item--nordly NORDLY
    li.client-logos__item.client-logos__item--halcyon Halcyon
    li.client-logos__item.client-logos__item--arco ARCO
    li.client-logos__item.client-logos__item--pinewood Pinewood
    li.client-logos__item.client-logos__item--vela VELA
    li.client-logos__item.client-logos__item--ostra ostra
  blockquote.testimonial
    span.testimonial__quote-mark(aria-hidden="true") “
    p.testimonial__text
      | Keepsake transformed our brand identity from the ground up. Their attention to detail and creative vision exceeded every expectation we had.
    footer.testimonial__author
      .testimonial__info
        .testimonial__avatar(aria-hidden="true") EL
        div
          p.testimonial__name Elena Lindqvist
          p.testimonial__role Creative Director, Nordly Studio
      .testimonial__dots(aria-hidden="true")
        span.testimonial__dot.testimonial__dot--active
        span.testimonial__dot
        span.testimonial__dot
